---
const { title = "HARENA" } = Astro.props;
const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const basePathNoSlash = basePath.replace(/\/$/, "");
const withBase = (path: string) => `${basePath}${path.replace(/^\//, "")}`;
const normalizePath = (path: string) => {
  const normalized = path.replace(/\/$/, "") || "/";

  if (
    basePathNoSlash &&
    basePathNoSlash !== "/" &&
    (normalized === basePathNoSlash || normalized.startsWith(`${basePathNoSlash}/`))
  ) {
    return normalized.slice(basePathNoSlash.length).replace(/\/$/, "") || "/";
  }

  return normalized;
};
const activePath = normalizePath(Astro.url.pathname);
const tabListInitialStyle =
  "display:inline-flex;justify-self:center;gap:8px;padding:0;border:0;background:transparent;box-shadow:none;";
const tabInitialStyle =
  "position:relative;display:inline-flex;min-height:40px;align-items:center;justify-content:center;border:1px solid transparent;border-radius:999px;background:transparent;box-shadow:none;padding:0 14px;font-size:0.88rem;font-weight:600;line-height:1;text-decoration:none;";
const tabs = [
  {
    href: withBase("/leadboard"),
    label: "Leaderboard",
    matches: ["/", "/leadboard", "/leaderboard"],
  },
  {
    href: withBase("/models"),
    label: "Models",
    matches: ["/models"],
  },
  {
    href: withBase("/datasets"),
    label: "Datasets",
    matches: ["/datasets"],
  },
  {
    href: withBase("/contribute"),
    label: "Contribute",
    matches: ["/contribute"],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A living benchmark for sensor-based human activity recognition on edge devices." />
    <link rel="icon" type="image/png" sizes="512x512" href={withBase("/favicon.png")} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase("/apple-touch-icon.png")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script is:inline>
      (function () {
        var theme = null;
        try {
          theme = localStorage.getItem("harena-theme");
        } catch (error) {}
        if (theme !== "dark" && theme !== "light") {
          theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <header class="site-nav">
      <nav aria-label="Primary">
        <a class="brand" href={withBase("/leadboard")}>
          <img
            class="brand-icon"
            src={withBase("/whar-arena-icon.png")}
            width="64"
            height="36"
            alt=""
            aria-hidden="true"
          />
          <span>HARena</span>
        </a>
        <div
          class="site-tabs"
          role="tablist"
          aria-label="HARENA sections"
          style={tabListInitialStyle}
        >
          {
            tabs.map((tab) => {
              const isActive = tab.matches.includes(activePath);
              const tabColor = isActive ? "var(--ink)" : "var(--muted-strong)";
              return (
                <a
                  class:list={["site-tab", { "is-active": isActive }]}
                  href={tab.href}
                  role="tab"
                  aria-selected={isActive ? "true" : "false"}
                  aria-current={isActive ? "page" : undefined}
                  style={`${tabInitialStyle}color:${tabColor};`}
                >
                  {tab.label}
                </a>
              );
            })
          }
        </div>
        <div class="nav-actions">
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark mode" title="Switch to dark mode">
          <svg class="theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"/></svg>
          <svg class="theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
        </div>
      </nav>
    </header>
    <slot />
    <footer class="review-notice">Anonymous submission for double-blind review.</footer>
  <script is:inline>
      (function () {
        var button = document.querySelector("[data-theme-toggle]");
        if (!button) return;
        function label() {
          var next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
          var text = "Switch to " + next + " mode";
          button.setAttribute("aria-label", text);
          button.setAttribute("title", text);
        }
        label();
        button.addEventListener("click", function () {
          var next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
          document.documentElement.dataset.theme = next;
          try {
            localStorage.setItem("harena-theme", next);
          } catch (error) {}
          label();
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: hsl(36 45% 98%);
    --panel: hsl(0 0% 100%);
    --panel-strong: hsl(33 31% 94%);
    --panel-soft: hsl(33 60% 96%);
    --ink: hsl(24 6% 17%);
    --muted: var(--muted);
    --muted-strong: hsl(30 7% 24%);
    --line: hsl(30 5% 93%);
    --line-strong: hsl(33 9% 83%);
    --ink-hsl: 24 6% 17%;
    --panel-hsl: 0 0% 100%;
    --panel-strong-hsl: 33 31% 94%;
    --positive-text: hsl(125 49% 33%);
    --danger-text: hsl(2 63% 45%);
    --notice-bg: hsl(48 90% 95%);
    --notice-line: hsl(48 70% 70%);
    --subtle-bg: hsl(33 31% 97%);
    --placeholder: hsl(35 6% 60%);
    --primary-hover: hsl(24 6% 27%);
    --heat-saturation: 78%;
    --heat-darken: 0%;
    --accent: var(--ink);
    --accent-strong: var(--ink);
    --positive: hsl(125 49% 43%);
    --warning: hsl(48 93% 45%);
    --danger: hsl(2 63% 54%);
    --gold: hsl(39 72% 54%);
    --display-serif: Georgia, "Times New Roman", ui-serif, serif;
    font-family:
      "baselGrotesk", "Inter", ui-sans-serif, system-ui, -apple-system,
      BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  :root[data-theme="dark"] {
    color-scheme: dark;
    --bg: hsl(30 6% 9%);
    --panel: hsl(30 5% 12%);
    --panel-strong: hsl(30 5% 18%);
    --panel-soft: hsl(30 6% 15%);
    --ink: hsl(36 14% 91%);
    --muted: hsl(35 7% 66%);
    --muted-strong: hsl(35 9% 78%);
    --line: hsl(30 5% 20%);
    --line-strong: hsl(30 5% 29%);
    --ink-hsl: 36 14% 91%;
    --panel-hsl: 30 5% 12%;
    --panel-strong-hsl: 30 5% 18%;
    --positive-text: hsl(125 50% 62%);
    --danger-text: hsl(2 80% 72%);
    --notice-bg: hsl(45 35% 16%);
    --notice-line: hsl(45 40% 34%);
    --subtle-bg: hsl(30 5% 16%);
    --placeholder: hsl(35 6% 50%);
    --primary-hover: hsl(36 14% 80%);
    --heat-saturation: 40%;
    --heat-darken: 54%;
  }

  * {
    box-sizing: border-box;
  }

  .review-notice {
    width: min(1440px, calc(100vw - 24px));
    margin: 24px auto 48px;
    color: var(--muted);
    text-align: center;
    font-size: 0.84rem;
  }

  .nav-actions {
    display: inline-flex;
    align-items: center;
    justify-self: end;
    gap: 8px;
  }

  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--panel);
    color: var(--ink);
    cursor: pointer;
  }

  .theme-toggle:hover,
  .theme-toggle:focus-visible {
    background: var(--panel-strong);
  }

  .theme-toggle svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .theme-icon-sun,
  :root[data-theme="dark"] .theme-icon-moon {
    display: none;
  }

  :root[data-theme="dark"] .theme-icon-sun {
    display: block;
  }

  :root[data-theme="dark"] .entity-marker,
  :root[data-theme="dark"] .scatter-marker-shape,
  :root[data-theme="dark"] .gap-dot {
    filter: brightness(1.35) saturate(1.1);
  }

  :root[data-theme="dark"] .brand-icon {
    filter: invert(1);
  }

  body {
    margin: 0;
    min-width: 320px;
    background: linear-gradient(180deg, var(--bg), var(--panel-soft) 64%);
    color: var(--ink);
    font-size: 15px;
    line-height: 1.5;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--line-strong);
    background: hsl(var(--panel-hsl) / 0.94);
    box-shadow: 0 4px 18px hsl(var(--ink-hsl) / 0.06);
    backdrop-filter: blur(18px);
  }

  .site-nav nav {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 14px;
    align-items: center;
    width: min(1440px, calc(100vw - 24px));
    min-height: 74px;
    margin: 0 auto;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: 13px;
    color: var(--ink);
    font-family: "Montserrat", "baselGrotesk", "Inter", ui-sans-serif, system-ui, sans-serif;
    font-size: 1.38rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1;
    text-decoration: none;
  }

  .brand:hover,
  .brand:focus-visible {
    opacity: 0.74;
    outline: none;
  }

  .brand-icon {
    display: block;
    flex: 0 0 auto;
    width: 64px;
    height: auto;
  }

  .site-tabs {
    display: inline-flex;
    justify-self: center;
    gap: 8px;
  }

  .site-tab {
    position: relative;
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    color: var(--muted-strong);
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 0 14px;
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
  }

  .site-tab:hover,
  .site-tab:focus-visible {
    border-color: var(--line-strong) !important;
    background: var(--panel-soft) !important;
    color: var(--ink) !important;
    outline: none;
  }

  .site-tab.is-active {
    border-color: var(--line-strong) !important;
    background: var(--panel-soft) !important;
    color: var(--ink) !important;
    box-shadow: 0 1px 3px hsl(var(--ink-hsl) / 0.06) !important;
  }

  @media (max-width: 720px) {
    .site-nav nav {
      grid-template-columns: minmax(0, 1fr) auto;
      min-height: 0;
      row-gap: 10px;
      padding: 10px 0;
    }

    .brand {
      gap: 10px;
      font-size: 1.16rem;
    }

    .brand-icon {
      width: 52px;
    }

    .site-tabs {
      grid-column: 1 / -1;
      grid-row: 2;
      width: 100%;
      gap: 6px;
      justify-content: flex-start;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .site-tabs::-webkit-scrollbar {
      display: none;
    }

    .site-tab {
      flex: 0 0 auto;
      min-height: 38px;
      padding: 0 12px;
      font-size: 0.82rem;
    }

  }

  button,
  input,
  select {
    font: inherit;
  }

  a {
    color: inherit;
  }

  ::selection {
    background: hsl(var(--ink-hsl) / 0.16);
  }
</style>
